; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Intel AMX & Arm SME Matrix Accelerator Subsystem (TitanMatrix / NexusAMX)
; Binary:    intel_amx.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = intel_amx.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, CPUID\AMX_TILE
%DeviceDesc_1% = Driver_Install, CPUID\AMX_INT8
%DeviceDesc_2% = Driver_Install, CPUID\AMX_BF16

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, CPUID\AMX_TILE
%DeviceDesc_1% = Driver_Install, CPUID\AMX_INT8
%DeviceDesc_2% = Driver_Install, CPUID\AMX_BF16

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
intel_amx.sys

[Driver_Install.Services]
AddService = intel_amx, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\intel_amx.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Intel Advanced Matrix Extensions (AMX) & Arm SME Driver"
DeviceDesc_0   = "Intel AMX & Arm SME Matrix Accelerator Subsystem (CPUID\AMX_TILE)"
DeviceDesc_1   = "Intel AMX & Arm SME Matrix Accelerator Subsystem (CPUID\AMX_INT8)"
DeviceDesc_2   = "Intel AMX & Arm SME Matrix Accelerator Subsystem (CPUID\AMX_BF16)"
