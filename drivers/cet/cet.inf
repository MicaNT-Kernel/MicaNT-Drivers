; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Intel CET & Hardware-Enforced Stack Protection Subsystem (TitanCET / AegisCET)
; Binary:    kshadowstack.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = kshadowstack.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, CPUID\CET_SS
%DeviceDesc_1% = Driver_Install, CPUID\CET_IBT

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, CPUID\CET_SS
%DeviceDesc_1% = Driver_Install, CPUID\CET_IBT

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
kshadowstack.sys

[Driver_Install.Services]
AddService = kshadowstack, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\kshadowstack.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Intel Control-Flow Enforcement Technology (CET) Kernel Driver"
DeviceDesc_0   = "Intel CET & Hardware-Enforced Stack Protection Subsystem (CPUID\CET_SS)"
DeviceDesc_1   = "Intel CET & Hardware-Enforced Stack Protection Subsystem (CPUID\CET_IBT)"
