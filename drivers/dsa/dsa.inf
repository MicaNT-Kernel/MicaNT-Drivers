; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Intel DSA & IAA Fast-Memory Streaming Subsystem (TitanDSA / NexusDSA)
; Binary:    intel_dsa.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = intel_dsa.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_0B25
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_0CFE

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_0B25
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_0CFE

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
intel_dsa.sys

[Driver_Install.Services]
AddService = intel_dsa, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 1
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\intel_dsa.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Intel Data Streaming Accelerator (DSA) & IAA Driver"
DeviceDesc_0   = "Intel DSA & IAA Fast-Memory Streaming Subsystem (PCI\VEN_8086&DEV_0B25)"
DeviceDesc_1   = "Intel DSA & IAA Fast-Memory Streaming Subsystem (PCI\VEN_8086&DEV_0CFE)"
