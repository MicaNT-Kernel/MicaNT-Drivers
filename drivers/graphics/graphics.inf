; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (TitanWDDM / NexusWDDM)
; Binary:    dxgkrnl.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Display
ClassGUID   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = dxgkrnl.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\CC_030000
%DeviceDesc_1% = Driver_Install, PCI\VEN_1E0F&DEV_3D12
%DeviceDesc_2% = Driver_Install, PCI\VEN_10DE
%DeviceDesc_3% = Driver_Install, PCI\VEN_1002
%DeviceDesc_4% = Driver_Install, PCI\VEN_8086

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\CC_030000
%DeviceDesc_1% = Driver_Install, PCI\VEN_1E0F&DEV_3D12
%DeviceDesc_2% = Driver_Install, PCI\VEN_10DE
%DeviceDesc_3% = Driver_Install, PCI\VEN_1002
%DeviceDesc_4% = Driver_Install, PCI\VEN_8086

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
dxgkrnl.sys

[Driver_Install.Services]
AddService = dxgkrnl, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\dxgkrnl.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "WDDM 3.2 DirectX Graphics Kernel & Display Miniport Driver"
DeviceDesc_0   = "Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (PCI\CC_030000)"
DeviceDesc_1   = "Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (PCI\VEN_1E0F&DEV_3D12)"
DeviceDesc_2   = "Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (PCI\VEN_10DE)"
DeviceDesc_3   = "Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (PCI\VEN_1002)"
DeviceDesc_4   = "Windows Display Driver Model (WDDM 3.2) & Graphics Kernel (PCI\VEN_8086)"
