; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Intel Thread Director (HFI) & AMD CPPC Heterogeneous Scheduling (TitanDirector / AegisScheduler)
; Binary:    intel_hfi.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = intel_hfi.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, ACPI\INTC1072
%DeviceDesc_1% = Driver_Install, CPUID\HFI
%DeviceDesc_2% = Driver_Install, MSR\HFI

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, ACPI\INTC1072
%DeviceDesc_1% = Driver_Install, CPUID\HFI
%DeviceDesc_2% = Driver_Install, MSR\HFI

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
intel_hfi.sys

[Driver_Install.Services]
AddService = intel_hfi, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\intel_hfi.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Intel Hardware Feedback Interface (HFI) & AMD CPPC Driver"
DeviceDesc_0   = "Intel Thread Director (HFI) & AMD CPPC Heterogeneous Scheduling (ACPI\INTC1072)"
DeviceDesc_1   = "Intel Thread Director (HFI) & AMD CPPC Heterogeneous Scheduling (CPUID\HFI)"
DeviceDesc_2   = "Intel Thread Director (HFI) & AMD CPPC Heterogeneous Scheduling (MSR\HFI)"
