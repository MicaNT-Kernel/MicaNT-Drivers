; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Hardware IOMMU (Intel VT-d / AMD-Vi / Arm SMMUv3) & Kernel DMA Protection (TitanIOMMU / AegisIOMMU)
; Binary:    dmar.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = dmar.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, ACPI\DMAR
%DeviceDesc_1% = Driver_Install, ACPI\IVRS
%DeviceDesc_2% = Driver_Install, ACPI\IORT

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, ACPI\DMAR
%DeviceDesc_1% = Driver_Install, ACPI\IVRS
%DeviceDesc_2% = Driver_Install, ACPI\IORT

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
dmar.sys

[Driver_Install.Services]
AddService = dmar, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\dmar.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Hardware I/O Memory Management Unit & DMA Remapping Driver"
DeviceDesc_0   = "Hardware IOMMU (Intel VT-d / AMD-Vi / Arm SMMUv3) & Kernel DMA Protection (ACPI\DMAR)"
DeviceDesc_1   = "Hardware IOMMU (Intel VT-d / AMD-Vi / Arm SMMUv3) & Kernel DMA Protection (ACPI\IVRS)"
DeviceDesc_2   = "Hardware IOMMU (Intel VT-d / AMD-Vi / Arm SMMUv3) & Kernel DMA Protection (ACPI\IORT)"
