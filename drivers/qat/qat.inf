; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Intel QuickAssist Technology (QAT 2.0 / 4xxx) Crypto/Compression Offload (TitanQAT / NexusQAT)
; Binary:    intel_qat.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = intel_qat.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_4940
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_4941

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_4940
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_4941

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
intel_qat.sys

[Driver_Install.Services]
AddService = intel_qat, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 1
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\intel_qat.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Intel QuickAssist Technology (QAT) Hardware Offload Driver"
DeviceDesc_0   = "Intel QuickAssist Technology (QAT 2.0 / 4xxx) Crypto/Compression Offload (PCI\VEN_8086&DEV_4940)"
DeviceDesc_1   = "Intel QuickAssist Technology (QAT 2.0 / 4xxx) Crypto/Compression Offload (PCI\VEN_8086&DEV_4941)"
