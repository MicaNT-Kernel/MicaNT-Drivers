; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Universal Serial Bus (USB 3.2 Gen 2) & xHCI 1.2 Host Controller (TitanUSB / NexusUSB)
; Binary:    usbxhci.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = USB
ClassGUID   = {36FC9E60-C465-11CF-8056-444553540000}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = usbxhci.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\CC_0C0330
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_8D31

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\CC_0C0330
%DeviceDesc_1% = Driver_Install, PCI\VEN_8086&DEV_8D31

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
usbxhci.sys

[Driver_Install.Services]
AddService = usbxhci, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\usbxhci.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "USB 3.2 eXtensible Host Controller Interface (xHCI) Driver"
DeviceDesc_0   = "Universal Serial Bus (USB 3.2 Gen 2) & xHCI 1.2 Host Controller (PCI\CC_0C0330)"
DeviceDesc_1   = "Universal Serial Bus (USB 3.2 Gen 2) & xHCI 1.2 Host Controller (PCI\VEN_8086&DEV_8D31)"
