; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: USB4 2.0 & Thunderbolt 4 Protocol Tunneling Subsystem (TitanUSB4 / NexusUSB4)
; Binary:    usb4host.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGUID   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = usb4host.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_9A1B
%DeviceDesc_1% = Driver_Install, PCI\CC_0C0340

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_9A1B
%DeviceDesc_1% = Driver_Install, PCI\CC_0C0340

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
usb4host.sys

[Driver_Install.Services]
AddService = usb4host, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\usb4host.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "USB4 2.0 Host Router & Thunderbolt 4 Tunneling Driver"
DeviceDesc_0   = "USB4 2.0 & Thunderbolt 4 Protocol Tunneling Subsystem (PCI\VEN_8086&DEV_9A1B)"
DeviceDesc_1   = "USB4 2.0 & Thunderbolt 4 Protocol Tunneling Subsystem (PCI\CC_0C0340)"
