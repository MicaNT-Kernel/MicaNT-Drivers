; ============================================================================
; MicaNT Sovereign Clean-Room Driver Installation Information
; Subsystem: Wi-Fi 7 (802.11be EHT) & WDI NetAdapterCx Miniport Subsystem (TitanWiFi / NexusWiFi)
; Binary:    wdiwifi.sys
; Standards: Clean-Room ISO C++23, zero telemetry, 100% offline
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 10/07/2026,10.0.26100.1
CatalogFile = wdiwifi.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_272B
%DeviceDesc_1% = Driver_Install, PCI\CC_028000

[Standard.NTarm64.10.0]
%DeviceDesc_0% = Driver_Install, PCI\VEN_8086&DEV_272B
%DeviceDesc_1% = Driver_Install, PCI\CC_028000

[Driver_Install]
CopyFiles = Driver_Files

[Driver_Files]
wdiwifi.sys

[Driver_Install.Services]
AddService = wdiwifi, 0x00000002, Service_Install

[Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\wdiwifi.sys

[Strings]
ProviderName     = "MicaNT Clean-Room Foundation"
ManufacturerName = "MicaNT Sovereign Hardware Architecture"
ServiceDesc      = "Wi-Fi 7 (802.11be) Wireless Network Adapter Driver"
DeviceDesc_0   = "Wi-Fi 7 (802.11be EHT) & WDI NetAdapterCx Miniport Subsystem (PCI\VEN_8086&DEV_272B)"
DeviceDesc_1   = "Wi-Fi 7 (802.11be EHT) & WDI NetAdapterCx Miniport Subsystem (PCI\CC_028000)"
